emp_id SERIAL PRIMARY KEY,
fname VARCHAR(500) NOT NULL,
lname VARCHAR(500) NOT NULL,
age INTEGER CHECK(age>22),
DOB DATE CHECK(DOB>'1990-01-01')
)


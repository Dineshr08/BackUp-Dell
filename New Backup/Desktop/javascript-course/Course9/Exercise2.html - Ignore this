<!DOCTYPE html>
<html>
  <head>
    <title>Dom - Amazon Shipping Calculator</title>
  </head>
  <body>
    <p>Amazon Shipping Calculator</p>
    <p class>Orders under $40 = +$10 shipping.</p>
    <p class>Orders over $40 = FREE shipping.</p>
    <input placeholder="Cost of order" class="js-input" onkeydown="
      handleCostKeyDown(event);
    ">
    <button onclick="
      costCalculate();
    ">Calculate</button>
    <p class="js-dollor-result"></p>


    <!-- <input placeholder="type something" class="js-textBox" onkeyup="
      dataAutoUpdate(event);
    ">
    <p class="js-autoUpdate"></p> -->

    <input placeholder="Type something" class="js-input"
      onkeyup="
        const inputElement = document.querySelector('.js-input');
        document.querySelector('.js-message')
          .innerHTML = inputElement.value;
      ">

    <p class="js-message"></p>


    <script>

      function dataAutoUpdate(event) {

        document.querySelector('.js-autoUpdate').innerHTML = event.value;

      }

      function handleCostKeyDown(event) {
        if (event.key === 'Enter') {
          costCalculate();
        }
      }

      function costCalculate() {
        const inputElement = document.querySelector('.js-input');
        let cost = Number(inputElement.value)
        if (cost < 40) {
          cost += 10;
        }

        document.querySelector('.js-dollor-result').innerHTML = `$${cost}`;

      }

    </script>
  </body>
</html>
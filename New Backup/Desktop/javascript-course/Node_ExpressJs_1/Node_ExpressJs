User Service Model:
"all the details related to connection to the db then get the data and store the data" ie usually all the api will interact with db and run query right those db query we write here. ie we actually create a function for each apis on each api what query it will do on db , that queries we actually write in the model.create a file called userModel.js under folder then create a function for each api, and each fun will contain the db query that will perform.

import pool from "../config/db";

export const getallUserService = async () => {

    const result  = await pool.query("SELECT * FROM user");
    return result.rows;

}

export const getUserByIDService = async (id) => {

    const result  = await pool.query("SELECT * FROM user WHERE id = $1 RETURNING *", [id]);
    return result.rows[0];

}

export const createUserService = async (name, email) => {

    const result  = await pool.query("INSERT INTO user (name, email) VALUES($1, $2) RETURNING * ", [name, email]);
    return result.rows[0];

}

export const updateUserByIDService = async ( name, email, id) => {

    const result  = await pool.query("UPDATE user SET name=$1, email=$2 WHERE id=$3  RETURNING * ", [name, email, id]);
    return result.rows[0];

}

export const deleteUserByIDService = async ( id) => {

    const result  = await pool.query("DELETE FROM user WHERE id=$1 RETURNING * ", [id]);
    return result.rows[0];

}

User Controller:
We will use the user model in controller.Create userController.js file undrr controller
First we will create the standar response for all the api.

import { createUserService,
    getallUserService,
    updateUserByIDService,
    getUserByIDService,
    deleteUserByIDService,

 } from "../model/userModel.js";
//Standardise respone

export const handleResponse = (res, status, message, data=null ) => {
    res.status(status).json({
        status,
        message,
        data,
    });
};

Then we will create the api function ie we have called in routes.here next will call the errorHandler which called after routes.

export const createUser = async(req, res, next) => {
    const {name, email} = req.body;
    try {
        const newUser = await createUserService(name, email);
        handleResponse(res, "201", "User Created Successfully", newUser);
    } catch(err) {
        next(err);
    }
    
};

export const getAllUser = async(req, res, next) => {

    try {
        const user = await getallUserService();
        handleResponse(res, "200", "User Fetched Successfully", user);
    } catch(err) {
        next(err);
    }
    
};

export const updateUser = async(req, res, next) => {
    const {name, email} = req.body;
    try {
        const user = await updateUserByIDService(name, email, req.param.id);
        if(!user) {
            return handleResponse(res, "404", "User Not Found");
        }
        handleResponse(res, "200", "User Updated Successfully", user);
    } catch(err) {
        next(err);
    }
    
};

export const getUser = async(req, res, next) => {
    try {
        const user = await getUserByIDService(req.param.id);
        if(!user) {
            return handleResponse(res, "404", "User Not Found");
        }
        handleResponse(res, "200", "User Fetched Successfully", user);
    } catch(err) {
        next(err);
    }
    
};

export const deleteUser = async(req, res, next) => {
    try {
        const user = await deleteUserByIDService(req.param.id);
        if(!user) {
            return handleResponse(res, "404", "User Not Found");
        }
        handleResponse(res, "200", "User Deleted Successfully", user);
    } catch(err) {
        next(err);
    }
    
};

